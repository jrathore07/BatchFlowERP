<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_material_category_list" model="ir.ui.view">
        <field name="name">batchflow.material.category.list</field>
        <field name="model">batchflow.material.category</field>
        <field name="arch" type="xml">
            <list string="Material Categories">
                <field name="name"/>
                <field name="description"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_material_category_form" model="ir.ui.view">
        <field name="name">batchflow.material.category.form</field>
        <field name="model">batchflow.material.category</field>
        <field name="arch" type="xml">
            <form string="Material Category">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="description"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_material_category" model="ir.actions.act_window">
        <field name="name">Material Categories</field>
        <field name="res_model">batchflow.material.category</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_batchflow_material_categories"
        name="Material Categories"
        parent="menu_batchflow_root"
        action="action_material_category"
        sequence="5"/>

</odoo>